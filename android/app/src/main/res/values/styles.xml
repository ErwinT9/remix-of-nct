<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Real app theme. This is what MainActivity runs under once the splash
      screen is dismissed (see postSplashScreenTheme below).

      Edge-to-edge notes:
      * No android:statusBarColor / android:navigationBarColor here — those are
        deprecated on API 35+ and are what Play flags. The system bars stay
        transparent because the window is laid out edge-to-edge from
        MainActivity via WindowCompat.setDecorFitsSystemWindows(window, false).
      * windowLightStatusBar/windowLightNavigationBar give correct icon
        contrast at cold start, before JS boots. values-night/ flips them.
        Once the web layer is up, SystemBars.setAppearance() keeps them in sync
        with the in-app light/dark preference (which is independent of the OS).
      * windowBackground is a DayNight colour so no white surface can ever be
        exposed behind the WebView in dark mode.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/appWindowBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
      Launch (splash) theme. postSplashScreenTheme is critical: without it the
      activity keeps this theme after the splash is dismissed, leaving
      @drawable/splash as the window background. Under edge-to-edge that
      drawable showed through as a white bar with splash/logo remnants.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
